# CashFlow IQ - Environment Configuration Example

# API Configuration
PROJECT_NAME="CashFlow IQ - ATM Cash Demand Predictor"
VERSION="1.0.0"
API_V1_STR="/api"

# Security & Session
SECRET_KEY="replace-with-a-secure-random-secret-key-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (PostgreSQL preferred, defaults to SQLite for local development)
DATABASE_URL="sqlite:///./cashflow_iq.db"
# Example PostgreSQL:
# DATABASE_URL="postgresql://user:password@localhost:5432/cashflow_iq"

# Machine Learning Artifacts
MODEL_PATH="models_storage/cash_demand_rf.joblib"
METADATA_PATH="models_storage/model_metadata.json"
DATA_DIR="data"

# Frontend Build Configuration
VITE_API_BASE_URL="http://localhost:8000/api"
